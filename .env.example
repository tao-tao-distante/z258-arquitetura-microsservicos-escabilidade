# Copy to .env and replace every value. Keep URL-sensitive passwords alphanumeric
# unless you percent-encode them before Compose inserts them into connection URLs.
POSTGRES_IDENTITY_PASSWORD=replace_with_random_alphanumeric_value
POSTGRES_TASK_PASSWORD=replace_with_random_alphanumeric_value
RABBITMQ_USER=task_manager
RABBITMQ_PASSWORD=replace_with_random_alphanumeric_value
JWT_SECRET=replace_with_at_least_32_random_characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_random_alphanumeric_value
# Rootful Docker uses /var/lib/docker. Rootless Docker must point to the
# daemon data root, usually $HOME/.local/share/docker.
DOCKER_ROOT_DIR=/var/lib/docker
